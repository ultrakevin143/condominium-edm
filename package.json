{
  "name": "bern-condo-edm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "tsx backend/scripts/database.ts migrate",
    "test": "tsx --test backend/tests/database-safety.test.ts backend/tests/environment.test.ts backend/tests/transform.test.ts backend/tests/quality.test.ts",
    "setup:local": "tsx backend/scripts/setup-local.ts",
    "db:local": "tsx backend/scripts/local-postgres.ts",
    "db:seed": "tsx backend/scripts/database.ts seed",
    "test:integration": "tsx backend/scripts/integration-test.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p frontend/tsconfig.json",
    "build": "npm run build -w backend && npm run build -w frontend",
    "format": "prettier --write .",
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:local": "tsx backend/scripts/run-local.ts dev",
    "start": "concurrently -k -n api,web \"npm run start -w backend\" \"npm run start -w frontend\"",
    "start:local": "tsx backend/scripts/run-local.ts start",
    "db:author": "tsx backend/scripts/database.ts dev",
    "test:browser": "tsx backend/scripts/browser-runner.ts",
    "test:acceptance": "tsx backend/scripts/integration-test.ts --acceptance",
    "test:security": "tsx backend/scripts/integration-test.ts --security",
    "db:neon:provision": "tsx backend/scripts/neon-provision.ts",
    "db:neon:demo": "tsx backend/scripts/neon-demo.ts",
    "db:neon:migrate": "tsx backend/scripts/neon-migrate.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "dotenv": "^17.2.3",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    }
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma",
    "seed": "tsx backend/prisma/seed.ts"
  }
}
