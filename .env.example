# Use separate pooled and direct PostgreSQL URLs. Do not put real credentials here.
DATABASE_URL=
DIRECT_URL=
# Remote runtime requires explicit opt-in, a pinned direct host, TLS and schema=bern_hub.
BERN_DATABASE_TARGET=local
BERN_NEON_HOST=
PORT=4400
WEB_ORIGIN=http://localhost:3400
# Private local-only demonstration password; setup:local generates one.
SEED_PASSWORD=
