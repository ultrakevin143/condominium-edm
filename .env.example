# Runtime API only: use the pooled URL with the restricted application role.
# Keep the direct migration credential in ignored .local/neon-migration.env.
DATABASE_URL=
# Prisma schema tooling may use this same restricted URL as a safe fallback.
# Never put the elevated migration credential here.
DIRECT_URL=
# Remote runtime requires explicit opt-in, a pinned endpoint, TLS and schema=bern_hub.
BERN_DATABASE_TARGET=local
BERN_NEON_HOST=
PORT=4400
WEB_ORIGIN=http://localhost:3400
# Private local-only demonstration password; setup:local generates one.
SEED_PASSWORD=
