{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "backend/dist",
    "rootDir": "backend"
  },
  "include": ["backend/**/*.ts"],
  "exclude": ["backend/dist"]
}
